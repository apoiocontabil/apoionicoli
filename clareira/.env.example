# Clareira — variáveis de ambiente.
# Somente NOMES e exemplos não secretos. Nenhuma chave real entra em arquivo
# versionado, bundle, log, captura ou URL.

# --- Desenvolvimento local (tudo tem padrão; nada é obrigatório) -------------
CLAREIRA_API_PORT=5274
CLAREIRA_DB=./.dados/clareira.db
CLAREIRA_ORIGENS=http://localhost:5273,http://127.0.0.1:5273

# --- Integrações: NENHUMA está configurada ----------------------------------
# Enquanto vazias, a aplicação declara o estado real em GET /v1/saude e nas
# telas onde a decisão da pessoa depende disso. O modo essencial da aula
# funciona sem qualquer uma delas.

# Pagamento. Sem isto, /v1/assinatura/contratar RECUSA com as pendências.
# Exige também preço aprovado e revisão legal — variável de ambiente não basta.
# CLAREIRA_PAGAMENTO_PROVEDOR=
# CLAREIRA_PAGAMENTO_CHAVE_SECRETA=
# CLAREIRA_PAGAMENTO_SEGREDO_WEBHOOK=

# Vídeo: upload, transcodificação, CDN e mídia privada com expiração.
# CLAREIRA_VIDEO_PROVEDOR=
# CLAREIRA_VIDEO_CHAVE=

# Assistência generativa e voz. Ver docs/REQUIREMENTS.md M7 e M8.
# CLAREIRA_IA_PROVEDOR=
# CLAREIRA_IA_CHAVE=
# CLAREIRA_VOZ_PROVEDOR=
# CLAREIRA_VOZ_CHAVE=

# E-mail: recuperação de acesso e lembretes opcionais.
# CLAREIRA_EMAIL_PROVEDOR=
# CLAREIRA_EMAIL_CHAVE=
